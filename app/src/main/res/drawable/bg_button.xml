<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/badge_glow_bg">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#330099B8" />
                    <corners android:radius="20dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/liquid_cyan" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1A0099B8" />
                    <corners android:radius="20dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/liquid_cyan" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
