<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Card Style -->
    <style name="Widget.EXPlayer.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.EXPlayer.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/liquid_cyan</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/badge_glow_bg</item>
    </style>

    <!-- Dialog Style -->
    <style name="Widget.EXPlayer.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <!-- Legacy Style Aliases -->
    <style name="Widget.EXPlayer.GlassCard" parent="Widget.EXPlayer.Card" />
    <style name="Widget.EXPlayer.GlassButton" parent="Widget.EXPlayer.Button" />
    <style name="Widget.EXPlayer.GlassDialog" parent="Widget.EXPlayer.Dialog" />
    <style name="Theme.eXPlayer.Glass" parent="Theme.eXPlayer" />
    <style name="Theme.EXPlayer.Glass" parent="Theme.EXPlayer" />

</resources>
