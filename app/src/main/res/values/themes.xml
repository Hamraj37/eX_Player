<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.eXPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/liquid_cyan</item>
        <item name="colorPrimaryVariant">@color/liquid_purple</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/liquid_blue</item>
        <item name="colorSecondaryVariant">@color/liquid_magenta</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar & Navigation bar -->
        <item name="android:statusBarColor">@color/liquid_bg_dark_start</item>
        <item name="android:navigationBarColor">@color/liquid_bg_dark_end</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Background -->
        <item name="android:windowBackground">@drawable/bg_liquid_dark</item>
    </style>

    <style name="Theme.EXPlayer" parent="Theme.eXPlayer" />

    <style name="ShapeAppearance.App.Corner8" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>
</resources>
